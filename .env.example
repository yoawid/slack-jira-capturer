# Copy to .env for local runs. In CI these come from repository secrets.
# Non-secret settings (channel, project keys, field IDs) live in capture.config.json;
# see capture.config.example.json.

# Slack: Bot User OAuth Token from api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...

# Atlassian: basic auth with an API token (id.atlassian.com → Security → API tokens)
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=...

# Optional overrides
# CAPTURE_CONFIG=./capture.config.json   # path to the config file
# CAPTURE_SINCE_HOURS=168                # look-back window, overrides the config value
# CAPTURE_DRY_RUN=1                      # read and report, create nothing
# CAPTURE_VERBOSE=1                      # print titles and permalinks in the log
