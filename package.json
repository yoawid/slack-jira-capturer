{
  "name": "slack-jira-capturer",
  "private": true,
  "type": "module",
  "description": "Files emoji-reacted Slack messages as Jira issues. Deterministic, config-driven, no model in the loop.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "capture": "tsx capture.ts",
    "capture:dry": "tsx capture.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
